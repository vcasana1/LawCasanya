\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Comparison of $|S(N)|$ for four phase sequences over $N\le 10^4$. \textbf  {(Top)} Actual Riemann zeros (blue), exhibiting bounded amplitude with quasi-periodic peaks. \textbf  {(Upper middle)} Shuffled real zeros (magenta), showing gradual diffusive growth. \textbf  {(Lower middle)} Deterministic ``von Mangoldt'' model (green), derived from $\gamma _n \approx 2\pi n/\log n$, showing drift due to lack of local cancellations. \textbf  {(Bottom)} i.i.d.\ uniform random phases (red), showing typical random-walk dispersion.}}{5}{figure.3}\protected@file@percent }
\newlabel{fig:models}{{3}{5}{Comparison of $|S(N)|$ for four phase sequences over $N\le 10^4$. \textbf {(Top)} Actual Riemann zeros (blue), exhibiting bounded amplitude with quasi-periodic peaks. \textbf {(Upper middle)} Shuffled real zeros (magenta), showing gradual diffusive growth. \textbf {(Lower middle)} Deterministic ``von Mangoldt'' model (green), derived from $\gamma _n \approx 2\pi n/\log n$, showing drift due to lack of local cancellations. \textbf {(Bottom)} i.i.d.\ uniform random phases (red), showing typical random-walk dispersion}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces FFT amplitude spectra of $|S(N)|$ (after removing the mean and applying Hann window) for the four models: actual Riemann zeros (blue, top), shuffled zeros (magenta, second), von Mangoldt model (green, third), and random i.i.d.\ phases (red, bottom). Horizontal axis shows equivalent period $T$ (in number of indices); only periods up to 50 are displayed. The real zeros display two sharp low-period peaks ($T\approx 7$ and $T\approx 10.5$) and a weaker resonance around $T\approx 24$, whereas the surrogate sequences show no such distinct low-period peaks.}}{6}{figure.4}\protected@file@percent }
\newlabel{fig:fftzeta}{{4}{6}{FFT amplitude spectra of $|S(N)|$ (after removing the mean and applying Hann window) for the four models: actual Riemann zeros (blue, top), shuffled zeros (magenta, second), von Mangoldt model (green, third), and random i.i.d.\ phases (red, bottom). Horizontal axis shows equivalent period $T$ (in number of indices); only periods up to 50 are displayed. The real zeros display two sharp low-period peaks ($T\approx 7$ and $T\approx 10.5$) and a weaker resonance around $T\approx 24$, whereas the surrogate sequences show no such distinct low-period peaks}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Spectrogram (sliding FFT with 1000-point Hann window, 50\% overlap) of $|S(N)|$ for real Riemann zeros. Color intensity indicates spectral amplitude (dB) as functions of period $T$ (vertical axis, in index units, up to 50) and the number of terms $N$ (horizontal axis, from 1000 to 9000). Horizontal ridges correspond to persistent periodicities. A primary band (yellow) tracks from $T\approx 15$ at $N=1000$ toward $T\approx 10$ by $N=9000$, consistent with density-driven chirp. Another strong band appears around $T\approx 7$, persisting across increasing $N$. Additional broader bands at higher periods (e.g., near 20--25 and 35--45 for smaller $N$) reflect slower interference effects.}}{7}{figure.5}\protected@file@percent }
\newlabel{fig:FFTcont}{{5}{7}{Spectrogram (sliding FFT with 1000-point Hann window, 50\% overlap) of $|S(N)|$ for real Riemann zeros. Color intensity indicates spectral amplitude (dB) as functions of period $T$ (vertical axis, in index units, up to 50) and the number of terms $N$ (horizontal axis, from 1000 to 9000). Horizontal ridges correspond to persistent periodicities. A primary band (yellow) tracks from $T\approx 15$ at $N=1000$ toward $T\approx 10$ by $N=9000$, consistent with density-driven chirp. Another strong band appears around $T\approx 7$, persisting across increasing $N$. Additional broader bands at higher periods (e.g., near 20--25 and 35--45 for smaller $N$) reflect slower interference effects}{figure.5}{}}
