\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Dependency map with logical status made explicit. Blue arrows are unconditional; green arrows require \(\mathrm  {RH}\); orange dashed arrows invoke the abstract endpoint hypotheses; the red branch is the external unconditional zeta-value Hankel application. The \(-2\) Li--Weil law therefore belongs to the RH branch because the positive Li--Cayley moment measures do, whereas the endpoint theorem itself does not assume \(\mathrm  {RH}\).}}{8}{figure.1}\protected@file@percent }
\newlabel{fig:structural_map}{{1}{8}{Dependency map with logical status made explicit. Blue arrows are unconditional; green arrows require \(\RH \); orange dashed arrows invoke the abstract endpoint hypotheses; the red branch is the external unconditional zeta-value Hankel application. The \(-2\) Li--Weil law therefore belongs to the RH branch because the positive Li--Cayley moment measures do, whereas the endpoint theorem itself does not assume \(\RH \)}{figure.1}{}}
